# Visual Studio 2015 user specific files
.vs/
*.sln
*.slnx
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Whos_Driving/Binaries/*
Whos_Driving/Plugins/*/Binaries/*

# Builds
Whos_Driving/Build/*

# Configuration files generated by the Editor
Whos_Driving/Saved/*

# Compiled source files for the engine to use
Whos_Driving/Intermediate/*
Whos_Driving/Plugins/*/Intermediate/*

# Cache files for the editor to use
Whos_Driving/DerivedDataCache/*

# Generated Visual Studio solutions
*.slnx

# Python bytecode
__pycache__/

*.py[cod]

# Local Editor preferences
Whos_Driving/Config/DefaultEditorPerProjectUserSettings.ini
